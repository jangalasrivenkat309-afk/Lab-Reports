  "item": [
    {
      "name": "01 - GET All Books (Default)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"]
        }
      }
    },
    {
      "name": "02 - Search by Title (search_q)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?search_q=javascript",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "javascript"
            }
          ]
        }
      }
    },
    {
      "name": "03 - Sort Books (order_by & order)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?order_by=price&order=DESC",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        }
      }
    },
    {
      "name": "04 - Price Range Filter (min_price & max_price)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?min_price=400&max_price=700",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            {
              "key": "min_price",
              "value": "400"
            },
            {
              "key": "max_price",
              "value": "700"
            }
          ]
        }
      }
    },
    {
      "name": "05 - Pagination (limit & offset)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books?limit=3&offset=2",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books"],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "2"
            }
          ]
        }
      }
    },
